# Copy to .env.local and fill in. Never commit .env.local.

# --- Browser (exposed to the client via Vite's VITE_ prefix) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth Web client id for student Sign in with Google (public by design;
# /api/google-sign-in also checks tokens against it). Unset hides the button.
VITE_GOOGLE_CLIENT_ID=

# --- Server only (api/ functions). Must never be VITE_-prefixed. ---

# Bypasses RLS: catalog writes, password RPCs, OTP storage.
SUPABASE_SERVICE_ROLE_KEY=

# Signs teacher session tokens. Falls back to SUPABASE_SERVICE_ROLE_KEY if unset,
# but set it explicitly so rotating one does not invalidate the other.
TEACHER_SESSION_SECRET=

# Signs student session tokens and email proofs. Same fallback as above; set it
# to its own value.
STUDENT_SESSION_SECRET=

# Outbound email (verification codes, ranking confirmations).
RESEND_API_KEY=

# Optional extra secret mixed into the one-time-code hash.
EMAIL_OTP_PEPPER=
